# ==============================================================================
# The Living Atelier — Environment Variables Configuration Template
# Copy this file to .env in your /server directory and fill in actual values.
# NEVER commit the real .env to version control!
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon Cloud PostgreSQL or Local PostgreSQL)
# Example Local: postgresql://postgres:YOUR_PASSWORD@localhost:5432/artstudio_dev?schema=public
# Example Neon: postgresql://username:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/artstudio?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/artstudio_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/artstudio_test?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-a-secure-cookie-secret-min-32-chars"

# Client CORS Configuration
# Local: http://localhost:5173
# Production: https://the-living-atelier.vercel.app
FRONTEND_URL="http://localhost:5173"
