# ==============================================================================
# The Living Atelier — Frontend Client Environment Variables Template
# ==============================================================================
# In local development, Vite proxies '/api' to http://localhost:5000.
# For Vercel production deployment, set VITE_API_URL to your Render backend URL:
# Example: VITE_API_URL=https://the-living-atelier-api.onrender.com/api

VITE_API_URL=/api
