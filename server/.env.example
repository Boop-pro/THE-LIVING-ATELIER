# ==============================================================================
# The Living Atelier — Server Environment Variables Template
# ==============================================================================
# Copy this file to .env in /server and fill in your actual production values.
# NEVER commit the real .env to version control!

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Connection (Neon Cloud PostgreSQL)
# Example: postgresql://username:password@ep-cool-butterfly-123456.ap-southeast-1.aws.neon.tech/artstudio?sslmode=require
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
TEST_DATABASE_URL="postgresql://username:password@host/dbname_test?sslmode=require"

# Authentication & Security
# Generate random 64-byte hex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-secure-random-64-byte-hex-string"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-a-secure-random-64-byte-hex-string"

# Studio Master Administrator Password Override (Optional: defaults to seed data if unset)
ADMIN_PASSWORD="YourStrongAdminPassword2026!"

# Allowed Frontend URL for Production CORS & Cookies
# Example: https://the-living-atelier.vercel.app
FRONTEND_URL="https://the-living-atelier.vercel.app"
